#!/bin/sh
# git's pre-push hook of this repository, which core.hooksPath names as the main checkout's
# tools/git-hooks, so that every checkout runs this one (tools/local-limits.mjs, hooksDir): it refuses
# a push of any commit whose tree tools/quick.mjs has not passed in the checkout that pushes
# (tools/push.mjs decides).
exec node "$(dirname "$0")/pre-push.mjs" "$@"
