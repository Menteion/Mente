// expect: E0236
module conformance
// An operand of `and` or `or` changes nothing (item 10). Here Tier 1 once read the inner
// `x == 0` after `bump` had made `x` 9, concluded that `zap` always runs, and proved `z` 7
// where the run leaves it 0.
fn bump(mut x: u8) -> u8
  ensures x == 9
  ensures result == 0
{
  x = 9
  0
}

fn zap(mut z: u8) -> u8
  ensures z == 7
  ensures result == 0
{
  z = 7
  0
}

pub fn f() -> u8[7..=7] {
  var x: u8 = 0
  var z: u8 = 0
  _ = (x == 0 and bump(mut x) == 0) or zap(mut z) == 0
  z
}
