// expect: E0502
module conformance
// The left operand of `and` is read before the right one runs: `x == 0` held then, but `x` is
// 9 inside the branch.
fn bump(mut x: u8) -> u8
  ensures x == 9
  ensures result == 0
{
  x = 9
  0
}

pub fn f() -> u8[0..=0] {
  var x: u8 = 0
  if x == 0 and bump(mut x) == 0 {
    return x
  }
  0
}
