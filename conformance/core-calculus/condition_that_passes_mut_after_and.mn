// expect: E0236
module conformance
// A condition decides and changes nothing (item 10): the right operand of this `and` passes `x`
// as `mut`, so `x == 0` would hold where the left operand ran and not in the branch, where the
// call has made `x` 9.
fn bump(mut x: u8) -> u8
  ensures x == 9
  ensures result == 0
{
  x = 9
  0
}

pub fn f() -> u8[0..=0] {
  var x: u8 = 0
  if x == 0 and bump(mut x) == 0 {
    return x
  }
  0
}
