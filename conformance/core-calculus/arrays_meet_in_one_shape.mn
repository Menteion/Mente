// expect: pass
module conformance
// Arrays meet in one machine shape wherever two of them become one value: the branches of an
// `if`, the arms of a `match`, and an element read from an exact literal. Each is held in a shape
// that holds every integer it may hold, and narrowed only where it lands (core-calculus.md, item
// 4). The nightly runs and the review of PR 189 found MIR building a branch's array in one shape
// and reading it in another: copying 4 bytes of a [4]i64 into a [4]u8, reading past a slot, or
// reading a row of `u64`s as `i64`s.

// The `else` branch's literal of literals alone keeps 1 exact, in a [4]i64 (nightly triage, root
// cause 11).
pub fn literal_branch(x: u8, c: bool) -> u8 {
  val a: [4]u8 = if c { [x; 4] } else { [1; 4] }
  val b: [4]u8 = [x; 4]
  a[1] + b[2]
}

// A branch block that binds an array and gives its name, beside a literal of literals alone,
// whose 7 MIR read as the low bytes of a [2]i64 (found by the review of PR 183, 2026-11-22).
pub fn named_branch(c: bool) -> u8 {
  val r: [2]u8 = if c { [7; 2] } else {
    val t: [2]u8 = [9; 2]
    t
  }
  r[1]
}

// Branches of a [2]i64 and a [2]i8, and arms of three element types.
pub fn branches(c: bool) -> [2]i64 = if c { [1_i64, 2] } else { [-1_i8, 3] }

pub fn arms(k: u8) -> [2]i64 = match k {
  0 => [1_i64, 2]
  1 => [-1_i8, 3]
  _ => [k, 4_u8]
}

// The `if` is a [4]u8 to the checker, but its `else` holds 300 until the array lands in a [4]u16.
pub fn wider_than_its_type(x: u8, c: bool) -> u16 {
  val a: [4]u16 = if c { [x; 4] } else { [300; 4] }
  a[1]
}

pub fn pair_wider_than_its_type(x: u8, c: bool) -> u16 {
  val a: [2]u16 = if c { [x, 1] } else { [300, 2] }
  a[1] + a[0]
}

pub fn bytes_beside_words(c: bool, y: u16) -> [2]u16 = if c { [1_u8, 2] } else { [y, 300] }

// Branches of an `i64` and a `u128` whose values meet in `i128`.
pub fn signed_beside_unsigned(c: bool) -> [1]i128 = if c { [-1_i64] } else { [18446744073709551615_u128] }

// A row of an exact literal read by index, in the literal's machine type.
pub fn row(k: usize[0..=1]) -> [2]u128 = [[0_i8, 1], [2_u128, 18446744073709551615]][k]

// An element of an exact literal, inside another exact literal.
pub fn element_in_a_literal(k: usize[0..=1]) -> [2]i128 = [[-1_i64, 18446744073709551615_u128][k], 1_i8]

// An `else if`, its branches of three shapes.
pub fn nested(a: u8, b: i8, c: bool, d: bool) -> [2]i16 = if c { [a, 1] } else if d { [b, -1] } else { [300_i16, a] }

// At the edge of 128 bits the branches still meet in one machine type: an `i8`'s integers
// beside a `u64`'s in an `i128`, a `u8`'s beside a `u128`'s in a `u128`. One more bit of either,
// an `i8`'s beside a `u128`'s, is E0222 (arrays_that_meet_beyond_128_bits.mn).
pub fn edge_signed(c: bool, x: i8, y: u64) -> [2]i128 = if c { [x; 2] } else { [y; 2] }

pub fn edge_unsigned(c: bool, x: u8, y: u128) -> [2]u128 = if c { [x; 2] } else { [y; 2] }
