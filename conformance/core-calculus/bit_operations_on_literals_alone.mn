// expect: pass
module conformance
// A bit operation, a shift or `~` whose operands are literals alone works in the type those
// literals take (core-calculus.md, item 5): the type of the smallest expression around it that
// has one, the other operands; where none has, the type of the place its value is narrowed
// into; and `i64` where there is neither.
struct P {
  m: u8
}

enum E {
  V(y: u8)
  W
}

fn mask(m: u8) -> u8 = m

// The other operands, wherever the value goes: `~3` is 252 beside a `u8`.
pub fn beside(a: u8) -> u8 = a & ~3

pub fn beside_into_a_wider_type(a: u8) -> u16 = a & ~3

pub fn beside_in_a_sum(a: u8) -> u16 = a + ~3

pub fn beside_through_arithmetic(a: u8) -> u16 = (1 + ~3) + a

pub fn beside_a_negation(a: u8) -> i16 = a - -(~3)

pub fn beside_a_signed(a: i8) -> i8 = a ^ ~0

pub fn beside_a_shift(a: u8) -> u8 = a | (1 << 7)

pub fn beside_two_types(a: u8, b: u16) -> u32 = a + b + ~3

pub fn beside_in_a_branch(a: u8, c: bool) -> u16 = if c { ~3 } else { a }

pub fn beside_in_an_arm(a: u8) -> u16 = match a {
  0 => ~3
  _ => a
}

pub fn beside_in_an_array(a: u8) -> [2]u16 = [~3, a]

pub fn beside_a_u128(a: u128) -> u128 = a ^ ~0

pub fn beside_an_i128(a: i128) -> i128 = a & ~0

// The place the value is narrowed into, where no operand has a type.
pub fn bound() -> u8 {
  val m: u8 = ~3
  m
}

pub fn bound_through_arithmetic() -> u16 {
  val m: u16 = 1 + ~3
  m
}

pub fn assigned(a: u8) -> u8 {
  var m: u8 = a
  m = ~0x0F
  m
}

pub fn compound(a: u8) -> u8 {
  var m: u8 = a
  m &= ~1
  m
}

pub fn stored() -> u16 {
  var xs: [2]u16 = [0; 2]
  xs[1] = 1 << 15
  xs[1]
}

pub fn passed() -> u8 = mask(~3)

pub fn field() -> u8 = P(m: ~3).m

pub fn payload() -> u8 = match E.V(y: ~3) {
  E.V(y: q) => q
  E.W => 0
}

pub fn returned(c: bool) -> u8 {
  if c {
    return ~3
  }
  ~0
}

pub fn element() -> [2]u8 = [~3, 1]

pub fn repeated() -> [2]u8 = [~3; 2]

pub fn nested() -> [1][2]u8 = [[~3, 1]]

pub fn in_a_branch(c: bool) -> u8 {
  val m: u8 = if c { ~3 } else { 4 }
  m
}

pub fn in_a_nested_branch(c: bool, d: bool) -> u8 {
  val m: u8 = if c { if d { ~3 } else { ~0 } } else { 4 }
  m
}

pub fn in_an_arm(c: bool) -> u8 {
  val m: u8 = match c {
    true => ~3
    false => 4
  }
  m
}

pub fn in_an_array_of_a_branch(c: bool) -> [1]u8 = if c { [~3] } else { [1] }

pub fn top_bit() -> u64 = 1 << 63

pub fn top_bit_set() -> u64 = 1 | 9223372036854775808

pub fn top_bit_of_128() -> u128 = 1 << 127

pub fn all_of_128() -> u128 = ~0

pub fn signed_place() -> i8 = ~0

pub fn signed_least() -> i8 = ~127

pub fn signed_least_of_128() -> i128 = ~170141183460469231731687303715884105727

// Neither: an `i64`, where `~3` is -4.
pub fn alone() -> i64 {
  val m = ~3
  m
}

pub fn alone_in_an_array() -> i64 {
  val xs = [~3, 1]
  xs[0]
}

pub fn compared(a: u8) -> bool = a == ~3

pub fn indexed(xs: [8]u8) -> u8 = xs[~3 & 7]

pub fn amount(a: u8) -> u8 = a << (~3 & 1)

pub fn scrutinee() -> u8 = match ~3 {
  -4 => 1
  _ => 2
}

// A literal the type does not hold traps where the operation narrows it.
pub fn outside() -> u8 {
  val m: u8 = -1 & 255
  m
}

pub fn past_the_type() -> u8 {
  val m: u8 = 256 | 1
  m
}

pub fn shifted_out() -> i8 = 1 << 7

pub fn shifted_by_the_width() -> u8 = 1 << 8

pub fn negative_shifted() -> u8 = -1 << 1

pub fn complement_of_a_literal_past_the_type() -> u8 = ~256

pub fn beside_and_past_the_type(a: u8) -> u8 = a & ~256

pub fn beside_at_its_edges() -> u16 = beside_in_a_sum(0) + beside_in_a_sum(255)

pub fn beside_two_types_at_their_edges() -> u32 = beside_two_types(0, 0) + beside_two_types(255, 65535)

pub fn branches() -> u8 = in_a_branch(true) - in_a_branch(false)

pub fn nested_branches() -> u8 = in_a_nested_branch(true, true) - in_a_nested_branch(true, false) + in_a_nested_branch(false, false)

pub fn returns() -> u8 = returned(false) - returned(true)

pub fn compared_at_252() -> bool = compared(252)

pub fn indexed_at_four() -> u8 = indexed([1, 2, 3, 4, 5, 6, 7, 8])

pub fn arms() -> u16 = beside_in_an_arm(0) + beside_in_an_arm(255)
