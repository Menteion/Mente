// expect: pass
module conformance
// A bit operation, a shift or `~` whose operands are literals alone works in the type those
// literals take (core-calculus.md, item 5): the type of the smallest expression around it that
// has one, the other operands, wherever the value goes; and `i64` where none has. The place a
// value is narrowed into never gives a literal its type: an `i64` value is narrowed there as
// any value is.
struct P {
  m: u8
}

fn mask(m: u8) -> u8 = m

// The other operands: `~3` is 252 beside a `u8`, whatever place the value goes to.
pub fn beside(a: u8) -> u8 = a & ~3

pub fn beside_into_a_wider_type(a: u8) -> u16 = a & ~3

pub fn beside_in_a_sum(a: u8) -> u16 = a + ~3

pub fn beside_through_arithmetic(a: u8) -> u16 = (1 + ~3) + a

pub fn beside_a_negation(a: u8) -> i16 = a - -(~3)

pub fn beside_a_signed(a: i8) -> i8 = a ^ ~0

pub fn beside_a_shift(a: u8) -> u8 = a | (1 << 7)

pub fn beside_two_types(a: u8, b: u16) -> u32 = a + b + ~3

pub fn beside_in_a_branch(a: u8, c: bool) -> u16 = if c { ~3 } else { a }

pub fn beside_in_an_arm(a: u8) -> u16 = match a {
  0 => ~3
  _ => a
}

pub fn beside_in_an_array(a: u8) -> [2]u16 = [~3, a]

pub fn beside_an_array_in_a_branch(c: bool, xs: [1]u8) -> [1]u8 = if c { [~3] } else { xs }

pub fn beside_a_u128(a: u128) -> u128 = a ^ ~0

pub fn beside_an_i128(a: i128) -> i128 = a & ~0

// `x op= e` is `x = x op e`: `x` is the other operand.
pub fn compound(a: u8) -> u8 {
  var m: u8 = a
  m &= ~1
  m
}

pub fn compound_of_an_element(a: u32) -> u16 {
  var xs: [2]u16 = [0, 0]
  xs[1] = a % 65536
  xs[1] ^= ~0
  xs[1]
}

// No other operand: an `i64`, narrowed where it lands.
pub fn fits_its_place() -> u8 {
  val m: u8 = 3 & 5
  m
}

pub fn shifted_into_its_place() -> u16 {
  var xs: [2]u16 = [0; 2]
  xs[1] = 1 << 15
  xs[1]
}

pub fn passed() -> u8 = mask(1 << 7)

pub fn field() -> i8 = P(m: 6 ^ 3).m

pub fn negative_and_a_mask() -> u8 {
  val m: u8 = -1 & 255
  m
}

pub fn signed_place() -> i8 = ~0

pub fn signed_least() -> i8 = ~127

pub fn in_a_branch(c: bool) -> u8 {
  val m: u8 = if c { ~3 } else { 4 }
  m
}

pub fn in_an_arm(c: bool) -> u8 {
  val m: u8 = match c {
    true => ~3
    false => 4
  }
  m
}

pub fn returned(c: bool) -> u8 {
  if c {
    return ~3 & 255
  }
  6 & 7
}

pub fn alone() -> i64 {
  val m = ~3
  m
}

pub fn alone_in_an_array() -> i64 {
  val xs = [~3, 1]
  xs[0]
}

pub fn compared(a: u8) -> bool = a == ~3

pub fn indexed(xs: [8]u8) -> u8 = xs[~3 & 7]

pub fn amount(a: u8) -> u8 = a << (~3 & 1)

pub fn scrutinee() -> u8 = match ~3 {
  -4 => 1
  _ => 2
}

// A suffix states the type, as the fix of a narrowing that always traps writes it.
pub fn suffixed() -> u8 {
  val m: u8 = ~3_u8
  m
}

pub fn suffixed_shift() -> u64 = 1_u64 << 63

pub fn suffixed_all() -> u128 = ~0_u128

// A literal outside `i64`, or shifted past it, traps where the operation narrows it into
// `i64`, before the value reaches its place.
pub fn shifted_out_of_i64() -> u64 = 1 << 63

pub fn literal_outside_i64() -> u64 = 1 | 9223372036854775808

pub fn shifted_by_the_width_of_i64() -> u128 = 1 << 64

pub fn beside_at_its_edges() -> u16 = beside_in_a_sum(0) + beside_in_a_sum(255)

pub fn beside_two_types_at_their_edges() -> u32 = beside_two_types(0, 0) + beside_two_types(255, 65535)

pub fn branch_that_traps() -> u8 = in_a_branch(true)

pub fn branch_that_fits() -> u8 = in_a_branch(false)

pub fn arm_that_traps() -> u8 = in_an_arm(true)

pub fn returns() -> u8 = returned(true) - returned(false)

pub fn compared_at_252() -> bool = compared(252)

pub fn indexed_at_four() -> u8 = indexed([1, 2, 3, 4, 5, 6, 7, 8])

pub fn arms() -> u16 = beside_in_an_arm(0) + beside_in_an_arm(255)

pub fn compounds() -> u32 = compound(255) + compound_of_an_element(0)
