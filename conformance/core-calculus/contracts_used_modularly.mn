// expect: pass
module conformance
pub fn midpoint(lo: usize, hi: usize) -> usize
  requires lo < hi
  ensures lo <= result and result < hi
= lo + (hi - lo) / 2

pub fn search(xs: [16]i32, target: i32) -> bool {
  var lo: usize = 0
  var hi: usize = xs.len
  while lo < hi {
    val mid = midpoint(lo, hi)
    if xs[mid] < target {
      lo = mid + 1
    } else if xs[mid] > target {
      hi = mid
    } else {
      return true
    }
  }
  false
}
