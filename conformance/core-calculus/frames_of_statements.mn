module conformance
// Item 25: a binding is held from its own statement, beside its initializer, to the end of
// its block; whatever else a statement holds ends with it; a value narrowed into another type
// is held beside the value it was; `_ = e` is a binding of `e`'s type; `p op= e` is
// `p = p op e`, a shift working in the type of `p`; the indexes of an assigned place are held
// before its value is evaluated; and a loop's rounds do not add up. A literal has the type it
// takes from its other operands, `i64` alone, and an array of literals the type its elements
// take, so a literal that takes `i64` is no narrowing into `i64`, whatever else stands among the
// elements; a literal no standard type holds is of no one type, and holds 16 bytes, as do the
// elements of an array of a `u8` and a `u32` before it lands; and a field built is narrowed
// into its type.
fn make() -> [4]u8 = [1_u8, 2_u8, 3_u8, 4_u8]

fn g() -> u64 = 1_u64

fn f(x: u64) -> u64 = x

fn h(mut ys: [2]u32) -> u32 = ys[0]

fn wide64() -> [1000]u64 = [0_u64; 1000]

fn pick(w: [1000]u64) -> usize = 0_usize

fn takes64(xs: [100]i64) -> u64 = 0_u64

pub struct P {
  a: u16
}

pub fn binding(n: u64) -> u64 {
  val a = n + 1
  a
}

pub fn refined(n: u64[0..10]) -> u64 {
  val a: u64[0..10] = n
  a
}

pub fn narrowed() -> u64 {
  val a: [4]u64 = make()
  a[0]
}

pub fn discard() {
  _ = g()
}

pub fn compound(x0: u64) -> u64 {
  var x = x0
  x += f(x)
  x
}

pub fn element(i: usize) -> u32 {
  var xs: [2]u32 = [1_u32, 2_u32]
  var ys: [2]u32 = [3_u32, 4_u32]
  xs[i] += h(mut ys)
  xs[0]
}

pub fn mixed(x0: u8, e: u32) -> u8 {
  var x = x0
  x += e
  x
}

pub fn rounds(n: u64) -> u64 {
  var i: u64 = 0
  while i < n {
    i += f(i)
  }
  i
}

pub fn shifted(x0: u8, k: u32) -> u8
  requires k < 8
{
  var x = x0
  x <<= k
  x
}

pub fn placed(c: bool, mut xs: [4]u8) {
  xs[if c {
    pick(wide64())
  } else {
    pick(wide64())
  }] = 1
}

// Private: the three execution paths are compared on public functions, and native code would
// hold this value more than once on a stack it does not count yet.
fn repeated() -> [70000]i64 = [0; 70000]

pub fn pair64() -> [2]i64 = [1, 2]

pub fn grid() -> [2][2]i64 = [[1, 2], [3, 4]]

pub fn hundred() -> u64 = takes64([0; 100])

pub fn small_elements(a: u8, k: usize) -> u8 = a + [1, 2][k]

pub fn built() -> P = P(a: 1)

pub fn tf() -> [2]i64 = [todo("x"), 1]

pub fn tg() -> [2][2]i64 = [[todo("x"), 1], [2, 3]]

pub fn th(c: bool) -> [2]i64 = if c {
  [todo("x"), 1]
} else {
  [2, 3]
}

pub fn uh2(a: u128[0..10], b: i8) -> bool = a + b == 1

pub fn uh3(a: u128[0..10], b: i8, k: usize) -> bool = a + b == [1, 2][k]

pub fn joined(a: u8, b: u32) -> [2]u32 = [a, b]
