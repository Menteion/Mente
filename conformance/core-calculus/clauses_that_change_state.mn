// expect: E0236 E0236 E0236 E0236
module conformance
// A contract clause states what holds without changing it (item 10): a `requires`, an
// `ensures`, a loop's `invariant` and a `decreases` that pass a binding `mut` are each refused.
// Under `@checked` such a clause would run, and the program would behave differently as its
// checks ran or were erased.
fn bump(mut x: u8) -> u8 {
  x = 9
  0
}

pub fn needs(mut n: u8) -> u8
  requires bump(mut n) == 0
= n

pub fn gives(mut n: u8) -> u8
  ensures bump(mut n) == 0
= n

pub fn holds(n: u8) -> u8 {
  var i: u8 = 0
  var j = n
  while i < 3 invariant bump(mut j) == 0 {
    i += 1
  }
  i
}

pub fn falls(n: u8) -> u8 {
  var i: u8 = 0
  var j = n
  while i < 3 decreases 3 - i + bump(mut j) {
    i += 1
  }
  i
}
