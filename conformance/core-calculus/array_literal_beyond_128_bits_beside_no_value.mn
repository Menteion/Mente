// expect: E0222 E0222 E0222
module conformance
// An element of no type holds no integer, and leaves before the literal holds a value: the
// integers of the other elements are kept in one machine type all the same, so an `i128` and a
// `u128` beside a `todo`, an array of one, or an `if` whose branches all return fit no one
// 128-bit type together (core-calculus.md, items 4 and 6).
pub fn flat(a: i128, b: u128) -> [3]i128 = [a, b, todo("x")]

pub fn nested(a: i128, b: u128) -> [3][1]i128 = [[a], [b], [todo("x")]]

pub fn between(a: i128, b: u128, c: bool) -> [3]i128 {
  val xs: [3]i128 = [a, if c { return [0; 3] } else { return [1; 3] }, b]
  xs
}
