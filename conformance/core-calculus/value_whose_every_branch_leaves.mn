// expect: pass
module conformance
// An `if` or a `match` whose every branch leaves gives no value, as `todo` does: the binding,
// the element or the argument it would give one to is never reached (core-calculus.md, item 6).
pub fn bound(c: bool, x: u8) -> u8 {
  val y = if c { todo("a") } else { todo("b") }
  y
}

pub fn matched(c: bool, x: u8) -> u8 {
  val y = match c {
    true => todo("a")
    false => unreachable("b")
  }
  y
}

pub fn element(c: bool, x: u8) -> u8 {
  val a: [2]u8 = [if c { todo("a") } else { todo("b") }, 1]
  a[1]
}

pub fn argument(c: bool, x: u8) -> u8 = twice(if c { todo("a") } else { todo("b") })

fn twice(x: u8) -> u8 = x + x
