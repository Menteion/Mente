// expect: E0502
module conformance
// The right operand of `and` runs where the left one holds, and what it changes stays changed.
fn bump(mut x: u8) -> u8
  ensures x == 9
  ensures result == 0
{
  x = 9
  0
}

pub fn f() -> u8[0..=0] {
  var x: u8 = 0
  if x == 0 and bump(mut x) == 0 {
    return 0
  }
  x
}
