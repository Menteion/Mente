// expect: E0502
module conformance
// An operator reads its left operand before its right one runs: `x * 1` is 0, though the
// call then sets `x` to 9.
fn bump(mut x: u8) -> u8
  ensures x == 9
  ensures result == 0
{
  x = 9
  0
}

pub fn f() -> u8[9..=9] {
  var x: u8 = 0
  val y = x * 1 + bump(mut x)
  y
}
