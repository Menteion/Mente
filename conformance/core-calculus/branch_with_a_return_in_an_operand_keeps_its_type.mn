// expect: E0203 E0203 E0203 E0203 E0203 E0203
module conformance
// A branch whose call, struct, variant, field read, index or `mut` call holds an `if` whose
// branches return still gives that construct's type, which the other branch shares
// (core-calculus.md, item 6).
struct P {
  a: u8
  b: u16
}

enum E {
  A(v: u8)
  B
}

fn mk(x: u8) -> P = P(a: x, b: 1)

pub fn call_arg(c: bool, x: u8) -> u8 {
  val y: u8 = if c { mk(if x > 1 { return 9 } else { return 8 }) } else { x }
  y
}

pub fn construct_field(c: bool, x: u8) -> u8 {
  val y: u8 = if c { P(a: x, b: if x > 1 { return 9 } else { return 8 }) } else { x }
  y
}

pub fn variant_payload(c: bool, x: u8) -> u8 {
  val y: u8 = if c { E.A(v: if x > 1 { return 9 } else { return 8 }) } else { x }
  y
}

pub fn field_of(c: bool, x: u8) -> u8 {
  val y: bool = if c { P(a: x, b: todo("r")).b } else { true }
  if y { 1 } else { 2 }
}

pub fn index_of(c: bool, x: u8) -> u8 {
  val y: bool = if c { [x, 2][if x > 1 { return 9 } else { return 8 }] } else { true }
  if y { 1 } else { 2 }
}

pub fn mut_arg(c: bool, x: u8) -> u8 {
  var z: u8 = x
  val y: bool = if c { bump(mut z, if x > 1 { return 9 } else { return 8 }) } else { true }
  if y { z } else { 2 }
}

fn bump(mut z: u8, k: u8) -> u8 {
  z = z + 1
  k
}
