// expect: pass
module conformance

pub fn sum_to(n: u32[0..1000]) -> u64
  requires n > 0
  ensures result >= 0
{
  var total: u64 = 0
  var i: u32 = 0
  while i < n invariant i <= n decreases n - i {
    i += 1
    guard i != 7 else {
      continue
    }
    if i == 999 {
      break
    }
    total += i
  }
  return total
}

pub fn swap_first(mut a: [4]u8, b: u8) -> bool {
  val old = a[0]
  a[0] = b
  old != b and not (a.len == 0)
}

pub fn caller() -> bool {
  var buffer: [4]u8 = [0; 4]
  swap_first(mut buffer, 3)
}

pub fn masks(x: u16) -> u16 = (x & 0x0F) | (x << 2) ^ ~x >> 1

pub fn pick(c: bool) -> i32 = if c { -1 } else { 1 }

pub fn grid() -> [2][3]i8 = [[0; 3]; 2]
