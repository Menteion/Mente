// expect: pass
module conformance
// A literal arm gives the scrutinee its value, and `_` after the lowest literals the rest.
pub fn zero(x: u8) -> u8[0..1] = match x {
  0 => x
  _ => 0
}

pub fn positive(n: u8) -> u8[1..=255] = match n {
  0 => 1
  _ => n
}

pub fn above_two(n: i8) -> i8[3..=127] = match n {
  0 => 3
  1 => 3
  2 => 3
  _ => if n < 3 { 3 } else { n }
}

pub fn main() -> u8 = zero(0) + positive(0) + positive(9)
