// expect: pass
module conformance
// Only the scrutinee's place is frozen in an arm that binds: another field of its binding
// changes freely, and so does the scrutinee in an arm that binds nothing.
pub enum Cell {
  Empty
  Held(n: u8)
}

pub struct Box {
  cell: Cell
  other: u8
}

fn bump(mut n: u8) {
  n = n / 2 + 1
}

pub fn take(mut b: Box) -> u8 = match b.cell {
  Cell.Held(n: n) => {
    b.other = n
    bump(mut b.other)
    n
  }
  Cell.Empty => {
    b.cell = Cell.Held(n: 1)
    0
  }
}

pub fn step(mut state: u8) {
  match state {
    0 => { state = 1 }
    1 => { state = 2 }
    _ => { state = 0 }
  }
}

pub fn main() -> u8 {
  var b = Box(cell: Cell.Empty, other: 0)
  val first = take(mut b)
  val second = take(mut b)
  first + second + b.other
}
