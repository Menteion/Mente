// expect: E0413 E0417 E0421
module conformance
// A number of @layout, @bytes or @bits may be as large as usize holds, and no sum or product of
// them overflows (morphic-layouts.md, item 2): an overlap whose fix would end past usize offers
// none, an array whose size passes usize has no size to check, and a bitstruct's overlap is told
// as any other. The fuzzer found the first two as panics of the checker.
@layout(size: 8, align: 8)
pub struct Overlap {
  @bytes(0..8) pub a: u64
  @bytes(0..18446744073709551615) pub b: u64
}

@layout(size: 4, align: 4)
pub struct Huge {
  @bytes(0..4) pub e: [9223372036854775808]u16
}

pub bitstruct Bits : u16 {
  @bits(0..8) pub a: u8
  @bits(0..18446744073709551615) pub b: u8
}
