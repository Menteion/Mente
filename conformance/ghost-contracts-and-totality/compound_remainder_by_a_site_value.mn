// expect: pass
module conformance
// A compound remainder whose right side has a site variable gives its value a variable of its
// own (spec item 2): it once took the right side's, and related the remainder to its divisor, the
// same variable, which emptied the state, so that Tier 1 proved whatever followed; since the
// stamps, the read of the right side stopped the compile. The forms: an index, a field read
// through an index, a remainder, an `if` and a `match`. Each remainder lies in 0 to 8, which its
// result holds.
pub struct S {
  d: u8[1..=9]
}

pub fn index(x: u8, a: [2]u8[1..=9]) -> u8[0..9] {
  var y = x
  y %= a[1]
  y
}

pub fn field(x: u8, b: [2]S) -> u8[0..9] {
  var y = x
  y %= b[1].d
  y
}

pub fn remainder(x: u8) -> u8[0..9] {
  var y = x
  y %= x % 7
  y
}

pub fn branch(x: u8, c: bool) -> u8[0..9] {
  var y = x
  y %= (if c { 3 } else { 9 })
  y
}

pub fn arms(x: u8, c: bool) -> u8[0..9] {
  var y = x
  y %= match c {
    true => 3
    false => 9
  }
  y
}
