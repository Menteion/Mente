// expect: pass
module conformance
pub fn gcd(a: u32, b: u32) -> u32 {
  var x: u32 = a
  var y: u32 = b
  while y != 0 decreases y {
    val t = x % y
    x = y
    y = t
  }
  x
}

pub fn isqrt(n: u64) -> u64 {
  var lo: u64 = 0
  var hi: u64 = 4294967296
  while hi - lo > 1 decreases hi - lo {
    val mid = lo + (hi - lo) / 2
    if mid * mid <= n {
      lo = mid
    } else {
      hi = mid
    }
  }
  lo
}

pub fn pairs(n: u8) -> u8 {
  var i: u8 = 0
  var j: u8 = 0
  while i < n invariant j <= 9 decreases n - i decreases 9 - j {
    if j < 9 {
      j += 1
    } else {
      i += 1
      j = 0
    }
  }
  i
}

pub fn down(n: u8) -> u8
  decreases n
{
  if n == 0 {
    return 0
  }
  down(n - 1)
}
