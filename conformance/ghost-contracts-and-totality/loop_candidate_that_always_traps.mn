// expect: E0508
module conformance
// A narrowing that always traps in a loop's condition is E0508, as it is outside a loop. It stands
// in a call, so its conjunct is no candidate (spec item 2, "Facts at a loop head"), and the loop's
// head keeps its state.
fn take(x: u8) -> u8 = x

pub fn always() -> u8 {
  var i: u8 = 0
  while take(300) == 0 and i < 1 {
    i += 1
  }
  i
}
