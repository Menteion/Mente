module matmul

/// The product of two 32 by 32 matrices, stored row by row, `reps` times. After each round one
/// entry changes, so no round can be computed once for all of them.
pub fn matmul(reps: u32) -> u64 {
  var a: [1024]u32 = [0; 1024]
  var b: [1024]u32 = [0; 1024]
  var c: [1024]u32 = [0; 1024]
  var seed: u64 = 12345
  var i: usize = 0
  while i < a.len {
    seed = (seed * 1103515245 + 12345) % 2147483648
    a[i] = seed % 1024
    seed = (seed * 1103515245 + 12345) % 2147483648
    b[i] = seed % 1024
    i += 1
  }
  var check: u64 = 0
  var r: u32 = 0
  while r < reps {
    var row: usize = 0
    while row < 32 {
      var col: usize = 0
      while col < 32 {
        var acc: u32 = 0
        var k: usize = 0
        while k < 32 {
          acc += a[row * 32 + k] * b[k * 32 + col]
          k += 1
        }
        c[row * 32 + col] = acc
        col += 1
      }
      row += 1
    }
    var total: u64 = 0
    var e: usize = 0
    while e < c.len {
      total += c[e]
      e += 1
    }
    check = (check * 31 + total) % 1000000007
    a[r % 1024] = check % 1024
    r += 1
  }
  check
}
