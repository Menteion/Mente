// A known limit of the independent SMT cross-check (docs/design-review.md,
// smt-independent-encoding): the encoding runs each loop at most 3 rounds, so a check that only
// the paths of a fourth round reach lies past the bound, and no query asks of it. Tier 1 proves
// the divisor below, which the refinement of `d` keeps from 0; but every path to it first runs
// the loop over `k` 4 rounds. The encoding names the check as cut off by the bound, never as
// unreachable, and the comparison with the base holds it so.
//
// smt beyond the bound: deep divisor at 17:7
module known_limit

pub fn deep(d: u8[1..=9]) -> u8 {
  var k: u8 = 0
  while k < 4 {
    k += 1
  }
  // Read only after the fourth round.
  k % d
}
