// A known limit of the independent SMT cross-check (docs/design-review.md,
// smt-independent-encoding): the encoding runs each loop at most 3 rounds, so a check that only
// the paths of a fourth round reach lies past the bound, and no query asks of it. Tier 1 proves
// the divisor below as it proves `rem`'s in loop-candidate-facts.mn, root cause 1 of the nightly
// triage of 2026-11-21, and rem2(0) traps there; but every path to it first runs the loop over
// `k` 4 rounds. The encoding names the check as cut off by the bound, never as unreachable, and
// the job counts it with the others against its baseline.
//
// smt beyond the bound: rem2 divisor at 19:23
module known_limit

pub fn rem2(d: u8) -> u8 {
  var k: u8 = 0
  while k < 4 {
    k += 1
  }
  var i: u8 = 0
  // Its condition reads `7 % d` at the loop's head; d = 0 traps there.
  while i < 1 and 7 % d < 9 {
    i += 1
  }
  k + i
}
