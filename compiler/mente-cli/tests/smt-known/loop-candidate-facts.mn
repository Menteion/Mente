// Known soundness bugs of Tier 1, which the independent SMT cross-check confirms
// (docs/design-review.md, smt-independent-encoding). Tier 1 assumes at a loop's head the
// candidate facts it reads from the loop's own condition and from the `guard`s of its body,
// evaluated where a `%` by `d` or a narrowing in them is taken not to trap; the check that it
// does not trap is then "proven" from that very fact, and left out of MIR and native code
// (the nightly triage of 2026-11-21, root cause 1).
//
// Each `smt:` line names a function and an obligation, its kind, place and tag as a query names
// it, which `mn smt --confirm --expect` holds as known once its model traps where its query says.
// Once Tier 1 no longer proves the check, its query is no longer written and the job fails on
// that line: delete the line, and this file once none is left.
//
// smt: rem divisor at 24:23
// smt: guarded divisor at 33:15
// smt: narrow range at 43:24 into `u8`
// smt: always range at 51:14 into `u8`
module known

fn take(x: u8) -> u8 = x

pub fn rem(d: u8) -> u8 {
  var i: u8 = 0
  // Its condition reads `7 % d` at the loop's head; d = 0 traps there.
  while i < 1 and 7 % d < 9 {
    i += 1
  }
  i
}

pub fn guarded(d: u8) -> u8 {
  var i: u8 = 0
  while i < 1 {
    guard 7 % d >= 0 else {
      return 9
    }
    i += 1
  }
  i
}

pub fn narrow(d: u8) -> u8 {
  var i: u8 = 0
  while i < 1 and take(d + 250) < 255 {
    i += 1
  }
  i
}

pub fn always() -> u8 {
  var i: u8 = 0
  while take(300) == 0 and i < 1 {
    i += 1
  }
  i
}
