// ============================================================================
// Example 03: colorless structured concurrency, zero-copy views in an arena, and deterministic
// simulation through capability effects
// Specs: spec/regions-and-pools.md, spec/error-handling-abi.md, spec/capability-effects.md, spec/structured-concurrency.md
// ============================================================================
module examples.colorless_concurrency_and_effects

pub enum GatewayError {
  InvalidToken
  Timeout
  UpstreamFailure(code: u16)
}

// The struct holds zero-copy str views directly; used inside an arena, it needs no <'a> lifetime.
pub struct OrderSummary {
  pub user_name: str
  pub items_slice: []str
  pub timestamp_ms: u64
}

pub fn verify_token(token: str) -> str ! GatewayError {
  guard token.starts_with("Bearer ") and token.len > 10 else { raise GatewayError.InvalidToken }
  token[7..token.len] // the signature decides what the view borrows: by default any view parameter, here only token
}

// The results live in the caller's arena, not in uid: `from arena` says so, and the caller need
// not keep uid alive as long as the results.
pub fn fetch_user_name(uid: str, in arena: Arena) -> str ! GatewayError from arena with Net
pub fn fetch_recent_items(uid: str, in arena: Arena) -> []str ! GatewayError from arena with Net

/// No async / await function coloring.
/// Driven by T ! GatewayError and by the Net and Clock capability effects.
pub fn handle_checkout_request(raw_token: str) -> u64 ! GatewayError with Net, Clock {
  val uid = verify_token(raw_token)!

  // A request-scoped arena: every view and temporary allocated in it is freed at once when the
  // block ends.
  Arena.scoped() { arena =>
    // Structured concurrency: both requests run at once and share uid and arena, with no 'static
    // bound. Both branches only read uid and only allocate through `in arena`, which the Law of
    // Exclusivity allows, and each branch allocates from its own chunk of the arena.
    // If either branch fails (!), the other is cancelled cooperatively and cleans up.
    val (name, items) = parallel (
      fetch_user_name(uid, in arena)!,
      fetch_recent_items(uid, in arena)!,
    )

    val summary = OrderSummary(
      user_name: name,
      items_slice: items,
      timestamp_ms: Clock.now_ms(),
    )

    summary.items_slice.len.to_u64() * 100 + summary.timestamp_ms
  }
}

// Deterministic Simulation Testing in one block: the business code is unchanged, and a handle
// block injects a deterministic clock and a simulated network. mn test also installs a seeded
// SimSched, so the two parallel branches run in the same order on every run.
@example("deterministic simulation of a structured concurrent request") {
  handle Clock = SimClock(fixed_ms: 5000),
         Net   = SimNet(user: "Alice", items: ["Mente Book", "SIMD Card"])
  {
    val result = handle_checkout_request("Bearer usr_998877")!
    assert(result == 2 * 100 + 5000)
  }
}
