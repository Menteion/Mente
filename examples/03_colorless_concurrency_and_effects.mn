// ============================================================================
// 標本 03：無染色結構化併發、Arena 零拷貝視圖與代數效應時光機測試
// 涵蓋站點：第三站 (Arena / 零 <'a>) + 第五站 (T ! E / with Effects) + 第六站 (parallel)
// ============================================================================
module examples.colorless_concurrency_and_effects

pub enum GatewayError {
  InvalidToken,
  Timeout,
  UpstreamFailure(code: u16),
}

// 結構體內部直接持有零拷貝 str 切片，放在 Arena 區域中使用時 0 個 <'a> 生命週期符號！
pub struct OrderSummary {
  pub user_name: str
  pub items_slice: []str
  pub timestamp_ms: u64
}

pub fn verify_token(token: str) -> str ! GatewayError {
  guard token.starts_with("Bearer ") and token.len > 10 else raise GatewayError.InvalidToken
  token[7..token.len] // 自動來源追蹤：編譯器自動得知回傳切片借用自參數 token，免寫 <'a>！
}

pub fn fetch_user_name(uid: str, in arena: Arena) -> str ! GatewayError with Net
pub fn fetch_recent_items(uid: str, in arena: Arena) -> []str ! GatewayError with Net

/// 無 async / await 函數染色！
/// 透過 T ! GatewayError（底層走 CPU Carry Flag 零空間開銷）與 with Net, Clock 代數效應驅動
pub fn handle_checkout_request(raw_token: str) -> u64 ! GatewayError with Net, Clock {
  val uid = verify_token(raw_token)!

  // 開啟 Request-Scoped Arena：內部所有零拷貝切片與暫存結構在離開區塊時 1 條指令瞬間整批釋放！
  with Arena.scoped() as arena {
    // 結構化併發 parallel：同時發出兩個網路請求，自動共享局部變數 uid 與 arena，0 個 'static 報錯！
    // 若任一分支失敗 (!)，另一分支自動收到協作取消信號並清理資源。
    val (name, items) = parallel (
      fetch_user_name(uid, in: arena)!,
      fetch_recent_items(uid, in: arena)!,
    )

    val summary = OrderSummary {
      user_name: name,
      items_slice: items,
      timestamp_ms: Clock.now_ms(),
    }

    summary.items_slice.len.to_u64() * 100 + summary.timestamp_ms
  }
}

// 一鍵時光機模擬測試（Deterministic Simulation Testing）：
// 無需修改業務程式碼，直接透過 with 攔截並注入確定性虛擬時鐘與模擬網路！
@example("確定性時光機與結構化併發測試") {
  with Clock = VirtualClock(fixed_ms: 5000),
       Net   = MockNet(user: "Alice", items: ["Mente Book", "SIMD Card"])
  {
    val result = handle_checkout_request("Bearer usr_998877")!
    assert(result == 2 * 100 + 5000)
  }
}
