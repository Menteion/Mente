// ============================================================================
// Example 02: mechanical sympathy, 64-byte cache-line contracts, morphic layouts, @branchless and @simd
// Specs: spec/refinement-and-fixed-point.md, spec/mutable-value-semantics.md, spec/morphic-layouts.md, spec/hardware-contracts.md
// ============================================================================
module examples.mechanical_sympathy_simd

// 1. Bit-exact packed struct (bitstruct): every bit is placed explicitly, and each field's type is
//    exactly as wide as its range; field access compiles to shifts and masks, with no branches.
pub bitstruct SpikeHeader : u32 {
  @bits(0..4)   pub region_id:  u4
  @bits(4..7)   pub priority:   u3
  @bits(7..8)   pub inhibitory: bool
  @bits(8..32)  pub target_idx: u24
}

// 2. A byte-exact 64-byte cache-line struct: the same bytes, in the same order, on every target.
@layout(size: 64, align: 64)
pub struct DeterministicCell {
  @bytes(0..8)   pub id:          u64
  @bytes(8..12)  pub potential:   sat<q16.16>
  @bytes(12..16) pub threshold:   q16.16
  @bytes(16..20) pub resting:     q16.16
  @bytes(20..24) pub last_header: SpikeHeader
  @bytes(24..64) pub dendrite_w:  [20]q1.15
}

// 3. No data-dependent branch (@branchless) and no heap allocation (@no_alloc).
//    A conditional jump left in the emitted machine code is a compile-time error (E0403).
@branchless
@no_alloc
pub fn integrate_cell(mut cell: DeterministicCell, drive: q16.16, leak_shift: u32[1..=8]) -> bool {
  val leaked = cell.potential - (cell.potential >> leak_shift)
  val next_v = leaked + drive
  val fired  = next_v >= cell.threshold

  // Lowered in MIR to a select over integers, which the backend emits as cmov / csel
  cell.potential = if fired { cell.resting } else { next_v }
  fired
}

// 4. Morphic layouts: the record is declared once, and the container alone chooses Tiled (AoSoA).
pub struct Particle {
  pub x: f32
  pub y: f32
  pub z: f32
  pub vx: f32
  pub vy: f32
  pub vz: f32
  pub mass: f32
}

/// Data parallelism plus SIMD: each worker takes whole 16-element tiles, and one f32 field of a
/// tile is exactly one 64-byte cache line. Through Cranelift that is four 128-bit vector
/// registers; a backend with AVX-512 would use one ZMM register.
@no_alloc
pub fn step_particles(mut batch: Tiled<Particle, lanes: 16>, dt: f32[0.0..=1.0]) {
  // batch is laid out in memory as 16-lane AoSoA tiles for shuffle-free SIMD loads, yet the code
  // still reads as plain field access: p is a copy-in/copy-out projection, and the compiler
  // vectorizes the loop over the field arrays directly.
  parallel_for p in mut batch @simd(lanes: 16) {
    p.x += p.vx * dt
    p.y += p.vy * dt
    p.z += p.vz * dt
  }
}

@example("branch-free cell integration on a 64-byte cache line") {
  var cell = DeterministicCell(
    id: 1,
    potential: 0.5_q16_16,
    threshold: 1.0_q16_16,
    resting: 0.0_q16_16,
    last_header: SpikeHeader(region_id: 2, priority: 5, inhibitory: false, target_idx: 42),
    dendrite_w: [0.0_q1_15; 20],
  )

  // mut at the call site shows at a glance that this line changes cell in place
  val did_fire = integrate_cell(mut cell, 0.75_q16_16, 2)
  assert(did_fire and cell.potential == 0.0_q16_16)
}
