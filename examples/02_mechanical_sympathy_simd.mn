// ============================================================================
// 標本 02：硬體機械同理心、64B 快取行契約、多態記憶體幾何與 @branchless / @kernel
// 規格：spec/refinement-and-fixed-point.md、spec/mutable-value-semantics.md、spec/morphic-layouts.md、spec/hardware-contracts.md
// ============================================================================
module examples.mechanical_sympathy_simd

// 1. 位元級打包結構體（bitstruct）：精確到每一個 Bit，編譯器自動合成零分支遮罩指令
pub bitstruct SpikeHeader : u32 {
  @bits(0..4)   pub region_id:  u4
  @bits(4..7)   pub priority:   u3
  @bits(7..8)   pub inhibitory: bool
  @bits(8..32)  pub target_idx: u24
}

// 2. 64-Byte CPU Cache-Line 逐位元組契約結構體（跨 x86-64 / ARM64 100% 位元級對齊）
@layout(size: 64, align: 64)
pub struct DeterministicCell {
  @bytes(0..8)   pub id:          u64
  @bytes(8..12)  pub potential:   sat<q16.16>
  @bytes(12..16) pub threshold:   q16.16
  @bytes(16..20) pub resting:     q16.16
  @bytes(20..24) pub last_header: SpikeHeader
  @bytes(24..64) pub dendrite_w:  [20]q1.15
}

// 3. 微架構零分支保證（@branchless）+ 零分配保證（@no_alloc）
//    若編譯器產生任何一條條件跳轉指令 (jmp/br)，編譯期將直接視為硬性錯誤攔截！
@branchless
@no_alloc
pub fn integrate_cell(mut cell: DeterministicCell, drive: q16.16, leak_shift: u32[1..=8]) -> bool {
  val leaked = cell.potential - (cell.potential >> leak_shift)
  val next_v = leaked + drive
  val fired  = next_v >= cell.threshold

  // 編譯器在 MIR RVSDG 層 100% 將此條件賦值編譯為單週期 cmov / csel 指令
  cell.potential = if fired { cell.resting } else { next_v }
  fired
}

// 4. 多態記憶體幾何（Morphic Layouts）：結構體只定義一次，容器一鍵切換為 Tiled (AoSoA)
pub struct Particle {
  pub x: f32
  pub y: f32
  pub z: f32
  pub vx: f32
  pub vy: f32
  pub vz: f32
  pub mass: f32
}

/// 統一異質核心（@kernel + @simd）：可同時由 MIR 編譯為 CPU AVX-512/NEON 或 GPU SPIR-V/PTX
@kernel
@simd(width: 16)
@no_alloc
pub fn step_particles(mut batch: Tiled<Particle, lanes: 16>, dt: f32[0.0..=1.0]) {
  // 儘管 batch 在物理記憶體中是以 16-lane AoSoA 微磚塊排列以達成 100% 零重排 SIMD 載入，
  // 開發者依然使用最直觀的欄位語法撰寫！
  parallel_for p in mut batch {
    p.x += p.vx * dt
    p.y += p.vy * dt
    p.z += p.vz * dt
  }
}

@example("64B 快取行無分支積分與 Tiled AoSoA 向量化更新") {
  var cell = DeterministicCell {
    id: 1,
    potential: 0.5_q16,
    threshold: 1.0_q16,
    resting: 0.0_q16,
    last_header: SpikeHeader { region_id: 2, priority: 5, inhibitory: false, target_idx: 42 },
    dendrite_w: [0.0_q1_15; 20],
  }

  // 呼叫端顯式標註 mut，一眼看出 cell 在此行被原地修改
  val did_fire = integrate_cell(mut cell, 0.75_q16, 2)
  assert(did_fire and cell.potential == 0.0_q16)
}
