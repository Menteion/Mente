// ============================================================================
// Example 01: refinement intervals, a contract used modularly, and a binary search that keeps no
// bounds check at run time
// Specs: spec/core-calculus.md, spec/refinement-and-fixed-point.md, spec/ghost-contracts-and-totality.md
// It runs in full at the end of M2. Its units and generics, which later milestones bring, are in
// example 05 (docs/design-review.md, example-01-m2).
// ============================================================================
module examples.refinement_and_units

/// The midpoint of two indices, strictly below `hi`. Tier 1 proves the contract from the body
/// once; every caller then uses the contract alone, never the body.
pub fn midpoint(lo: usize, hi: usize) -> usize
  requires lo < hi
  ensures lo <= result and result < hi
= lo + (hi - lo) / 2

/// Constructive termination (@total + decreases): the compiler proves the loop ends and that
/// every index stays in bounds, so no bounds check is left at run time.
@total
pub fn binary_search_exact(items: []i64, target: i64) -> ?usize[0..items.len]
  requires items.len > 0
{
  var lo: usize[0..=items.len] = 0
  var hi: usize[0..=items.len] = items.len

  while lo < hi decreases hi - lo {
    // midpoint's ensures puts mid in [lo, hi), so items[mid] below is proven in bounds.
    val mid: usize[0..items.len] = midpoint(lo, hi)
    val current = items[mid]

    if current == target { return mid }
    if current < target  { lo = mid + 1 } else { hi = mid }
  }
  none
}

/// Searches a sorted array, viewed whole with sorted[..]: `mn run` prints 3.
pub fn main() -> ?usize {
  val sorted: [6]i64 = [10, 20, 35, 50, 80, 130]
  binary_search_exact(sorted[..], 50)
}

// @example: specified to run under mn test; mn test does not execute @example bodies yet. main
// above runs the same search under mn run.
@example("an in-bounds binary search") {
  val sorted: [6]i64 = [10, 20, 35, 50, 80, 130]
  guard val found = binary_search_exact(sorted[..], 50) else { unreachable("50 is in the array") }
  assert(found == 3 and sorted[found] == 50)
}
