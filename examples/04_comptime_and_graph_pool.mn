// ============================================================================
// Example 04: a generational object pool (Pool / Handle) and comptime metaprogramming in plain .mn
// Specs: spec/regions-and-pools.md, spec/traits-and-generics.md, spec/comptime-and-ffi.md
// ============================================================================
module examples.comptime_and_graph_pool

// 1. A generational Pool<T> with 64-bit Handle<T> values builds a two-way, even cyclic, graph with
//    no unsafe code and no reference-count leaks.
// Scene nodes live in the pool for a long time, so a node owns its name as a String, not a str view.
pub struct SceneNode {
  pub name: String
  pub parent: ?Handle<SceneNode> = none
  pub children: List<Handle<SceneNode>> = []
}

pub fn link_parent_child(
  mut pool: Pool<SceneNode>,
  parent_h: Handle<SceneNode>,
  child_h: Handle<SceneNode>,
) {
  // pool[mut h] is a mutable ?SceneNode projection: none when the handle is stale, and ?. then does nothing
  pool[mut parent_h]?.children.push(child_h)
  pool[mut child_h]?.parent = parent_h
}

// 2. comptime metaprogramming in the language itself:
//    no separate macro language. At compile time Type.of<T>() is an ordinary value, and a plain
//    for loop walks its fields.
pub trait ByteSink {
  fn write_u64(mut self, v: u64)
  fn write_str(mut self, s: str)
}

pub fn encode_record<T>(mut sink: ByteSink, record: T) {
  // Expands at compile time into straight-line field writes, with no runtime reflection
  comptime for field in Type.of<T>().fields {
    comptime if field.ty == u64 {
      sink.write_u64(record.(field.name))
    } else if field.ty == str {
      sink.write_str(record.(field.name))
    }
  }
}

pub struct TelemetryEvent {
  pub trace_id: u64
  pub service:  str
  pub latency:  u64
}

@example("a two-way scene tree without unsafe code") {
  var scene = Pool<SceneNode>.new()
  val root  = scene.insert(SceneNode { name: String.from("Root") })
  val cam   = scene.insert(SceneNode { name: String.from("Camera") })

  link_parent_child(mut scene, root, cam)

  // scene[h] is a ?SceneNode: narrow it with guard before reading a field
  guard val root_node = scene[root] else panic("root is live")
  guard val cam_node  = scene[cam] else panic("camera is live")
  assert(root_node.children.len == 1)
  assert(cam_node.parent == root)
}
