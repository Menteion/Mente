module prelim

pub fn count_primes_below(n: u32) -> u32 {
  var composite: [10001]bool = [false; 10001]
  var count: u32 = 0
  var i: usize = 2
  while i < n {
    if not composite[i] {
      count += 1
      var j: usize = i * i
      while j < n {
        composite[j] = true
        j += i
      }
    }
    i += 1
  }
  count
}
