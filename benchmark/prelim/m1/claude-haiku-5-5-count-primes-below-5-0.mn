module prelim

pub fn count_primes_below(n: u32) -> u32 {
  var count: u32 = 0
  var k: u32 = 2
  while k < n {
    var d: u32 = 2
    var composite = false
    while d * d <= k {
      if k % d == 0 {
        composite = true
        break
      }
      d += 1
    }
    if not composite {
      count += 1
    }
    k += 1
  }
  count
}
