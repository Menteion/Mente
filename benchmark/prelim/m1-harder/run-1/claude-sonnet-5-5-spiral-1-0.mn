module prelim

pub fn spiral(m: [4][5]i32) -> [20]i32 {
  var out: [20]i32 = [0; 20]
  var top: usize = 0
  var bottom: usize = 4
  var left: usize = 0
  var right: usize = 5
  var k: usize = 0
  var c: usize = 0
  var r: usize = 0
  while top < bottom and left < right {
    c = left
    while c < right {
      out[k] = m[top][c]
      k += 1
      c += 1
    }
    top += 1
    r = top
    while r < bottom {
      out[k] = m[r][right - 1]
      k += 1
      r += 1
    }
    right -= 1
    if top < bottom {
      c = right
      while c > left {
        c -= 1
        out[k] = m[bottom - 1][c]
        k += 1
      }
      bottom -= 1
    }
    if left < right {
      r = bottom
      while r > top {
        r -= 1
        out[k] = m[r][left]
        k += 1
      }
      left += 1
    }
  }
  out
}
