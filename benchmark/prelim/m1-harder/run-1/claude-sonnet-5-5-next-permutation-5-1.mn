module prelim

pub fn next_permutation(mut a: [6]i32) -> bool {
  var i: usize = 5
  var searching = true
  while i > 0 and searching {
    if a[i - 1] < a[i] {
      searching = false
    } else {
      i -= 1
    }
  }
  val has_next = i > 0
  if has_next {
    val pivot = a[i - 1]
    var j: usize = 5
    while j > i and a[j] <= pivot {
      j -= 1
    }
    val t = a[i - 1]
    a[i - 1] = a[j]
    a[j] = t
  }
  var lo: usize = i
  var hi: usize = 5
  while lo < hi {
    val u = a[lo]
    a[lo] = a[hi]
    a[hi] = u
    lo += 1
    hi -= 1
  }
  return has_next
}
