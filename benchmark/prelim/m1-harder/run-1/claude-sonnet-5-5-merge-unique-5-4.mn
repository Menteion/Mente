module prelim

pub fn merge_unique(a: [8]i32, b: [8]i32, mut out: [16]i32) -> usize[0..=16] {
  var i: usize = 0
  var j: usize = 0
  var n: usize = 0
  while i < 8 or j < 8 {
    var v: i32 = 0
    if i < 8 and j < 8 {
      if a[i] <= b[j] {
        v = a[i]
        i += 1
      } else {
        v = b[j]
        j += 1
      }
    } else if i < 8 {
      v = a[i]
      i += 1
    } else {
      guard j < 8 else {
        unreachable("the loop condition leaves j < 8")
      }
      v = b[j]
      j += 1
    }
    var fresh = true
    if n > 0 {
      guard n <= 16 else {
        unreachable("n never exceeds 16")
      }
      if out[n - 1] == v {
        fresh = false
      }
    }
    if fresh {
      guard n < 16 else {
        unreachable("distinct values written never exceed 16")
      }
      out[n] = v
      n += 1
    }
  }
  guard n <= 16 else {
    unreachable("n never exceeds 16")
  }
  n
}
