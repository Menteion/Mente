module prelim

pub fn merge_unique(a: [8]i32, b: [8]i32, mut out: [16]i32) -> usize[0..=16] {
  var i: usize = 0
  var j: usize = 0
  var k: usize[0..=16] = 0
  while i < 8 or j < 8 {
    var v: i32 = 0
    if j >= 8 {
      v = a[i]
      i += 1
    } else if i >= 8 {
      v = b[j]
      j += 1
    } else if a[i] <= b[j] {
      v = a[i]
      i += 1
    } else {
      v = b[j]
      j += 1
    }
    var fresh = true
    if k > 0 {
      if out[k - 1] == v {
        fresh = false
      }
    }
    if fresh {
      guard k < 16 else {
        unreachable("at most 16 values can be written")
      }
      out[k] = v
      k += 1
    }
  }
  k
}
