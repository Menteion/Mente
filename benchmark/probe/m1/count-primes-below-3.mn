module probe

pub fn count_primes_below(n: u32) -> u32 {
  var count: u32 = 0
  var k: u32 = 2
  while k < n {
    var d: u32 = 2
    var is_prime: bool = true
    while d * d <= k {
      if k % d == 0 {
        is_prime = false
        break
      }
      d += 1
    }
    if is_prime {
      count += 1
    }
    k += 1
  }
  count
}
