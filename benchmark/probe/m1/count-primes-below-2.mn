module probe

pub fn count_primes_below(n: u32) -> u32 {
  var count: u32 = 0
  var i: u32 = 2
  while i < n {
    var d: u32 = 2
    var is_prime: bool = true
    while d * d <= i {
      if i % d == 0 {
        is_prime = false
        break
      }
      d += 1
    }
    if is_prime {
      count += 1
    }
    i += 1
  }
  count
}
